#version 150
#include clinker:dither

in vec2 texCoord;
in vec4 vertexColor;

out vec4 fragColor;

void main() {
    vec4 col = vertexColor;
    col.a = dither(int(gl_FragCoord.x), int(gl_FragCoord.y), col.a);
    if (col.a < 0.01) discard;
    fragColor = col;
}



















































































































































