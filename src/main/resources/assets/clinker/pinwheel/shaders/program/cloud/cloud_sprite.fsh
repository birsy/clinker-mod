
uniform sampler2D NoiseSampler;
uniform float GameTime;

in vec2 texCoord;
out vec4 fragColor;

void main() {
    float time = GameTime * 0.1;

	vec2 noiseTex = texCoord * 0.05;
	vec4 noise = texture(NoiseSampler, noiseTex * 0.5 + time * 0.01);
	vec4 noise2 = texture(NoiseSampler, noiseTex + noise.b * 0.2 - time * 0.01);

	vec2 normalizedUvs = texCoord * 2 - 1;
	float circle = smoothstep(0, 1, smoothstep(1, noise2.b * noise2.b * 0.8, length(normalizedUvs)));

    fragColor = vec4(vec3(1.0), circle);
}






















































































































































































































